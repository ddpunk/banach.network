---
// Szablon dla dlugich tekstow (manifest, technologia): naglowek, spis sekcji z boku, kolumna tekstu.
import Base from './Base.astro';
import type { Locale } from '../i18n';
interface Props { title: string; description: string; eyebrow?: string; h1: string; lead?: string; headings: { depth: number; slug: string; text: string }[]; locale?: Locale; path: string }
const { title, description, eyebrow, h1, lead, headings, locale = 'pl', path } = Astro.props;
const toc = headings.filter(h => h.depth === 2);
---
<Base title={title} description={description} locale={locale} path={path}>
  <section class="section">
    <div class="wrap">
      {eyebrow && <p class="eyebrow">{eyebrow}</p>}
      <h1>{h1}</h1>
      {lead && <p class="lead">{lead}</p>}
    </div>
  </section>
  <section class="section">
    <div class="wrap two-col">
      <nav class="toc" aria-label="Spis sekcji">
        <ol>
          {toc.map(h => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}
        </ol>
      </nav>
      <article class="prose">
        <slot />
      </article>
    </div>
  </section>
</Base>
